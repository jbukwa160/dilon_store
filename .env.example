# Public address of the shop (used in links, sitemap and e-mails)
NEXT_PUBLIC_SITE_URL=https://kadife.bg

# Where orders are saved (orders.jsonl). Keep it OUTSIDE the project folder.
DATA_DIR=../kadife-data

# E-mail for new orders. Without SMTP the orders are only saved to DATA_DIR/orders.jsonl.
SHOP_EMAIL=poruchki@kadife.bg
MAIL_FROM="Кадифе <no-reply@kadife.bg>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Only for `npm run enrich` (writes product descriptions). Not needed on the server.
OPENAI_API_KEY=
